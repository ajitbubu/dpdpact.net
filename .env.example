# Optional. The production GA4 Measurement ID is committed in
# src/app/layout.tsx, so analytics work on a production build with no config
# here at all.
#
# Set this only to point a deployment somewhere else — a staging property, or
# to switch analytics on locally while testing.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional, and the same story: the production Tag Manager container is
# committed in src/app/layout.tsx and needs no config here.
#
# Set this to point a deployment at a different container. The container is
# mounted alongside GA4 and follows it, so locally it needs NEXT_PUBLIC_GA_ID
# set too - this on its own loads nothing. Either way it waits for consent.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
